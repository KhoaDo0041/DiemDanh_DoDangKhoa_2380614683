{
  "ConnectionStrings": {
    // PostgreSQL chạy trên máy: docker compose up -d db (user/pass postgres/postgres)
    // Lên Render: đặt biến ConnectionStrings__DefaultConnection = chuỗi Session pooler của Supabase
    "DefaultConnection": "Host=localhost;Port=5432;Database=DiemDanhDB_DoDangKhoa_2380614683;Username=postgres;Password=postgres"
  },
  "JWTKey": {
    "Secret": "DiemDanh_DoDangKhoa_2380614683_SuperLongSecretKey_ForJWT_HS256!",
    "ValidIssuer": "DiemDanh_DoDangKhoa_2380614683_API",
    "ValidAudience": "DiemDanh_DoDangKhoa_2380614683_App",
    "TokenExpiryTimeInHour": "8"
  },
  "Email": {
    // Gửi OTP qua Gmail: điền Gmail + App Password (16 ký tự) của bạn.
    // Để trống AppPassword -> không gửi mail, mã OTP in ra console và hiện trên app (chế độ demo).
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "",
    "AppPassword": "",
    "FromName": "Điểm danh SV - Đỗ Đăng Khoa",
    // true = chưa gửi được mail thì trả mã OTP về app (ô vàng) để demo, kể cả trên Render.
    // Khi đã cấu hình Gmail thì mail gửi được -> không trả mã, nên để true không ảnh hưởng.
    "ShowCodeIfNotSent": true
  },
  "Face": {
    // Khoảng cách tối đa giữa 2 khuôn mặt để coi là cùng 1 người (càng nhỏ càng khắt khe)
    "Threshold": 0.08
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
